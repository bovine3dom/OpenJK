body, div, h1, h2 { display: block; }
body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: #0b1015;
    color: #e3e7e9;
    font-family: IBM Plex Sans;
    font-weight: 600;
    font-size: 15dp;
}
#console { margin: 24dp; }
.header { border-left: 3dp #67757f; padding-left: 17dp; margin-bottom: 20dp; }
.eyebrow, .technical, .designation, .series, label, #progress, #profile {
    font-family: IBM Plex Mono;
    font-weight: normal;
}
.eyebrow { color: #a6b4bd; font-size: 11dp; letter-spacing: 2dp; }
h1 { font-size: 32dp; margin: 4dp 0; }
.subtitle { color: #a6b4bd; font-size: 14dp; }
#last { margin-top: 9dp; }
.technical { color: #8496a3; font-size: 10dp; letter-spacing: 1dp; }
.campaigns { display: flex; align-items: stretch; }
.card { flex: 1; min-width: 0; background-color: #151b20; border: 1dp #364047; padding: 18dp; }
.academy { margin-right: 14dp; border-top: 3dp #e8ad59; }
.outcast { border-top: 3dp #6dcbd8; background-color: #111e25; }
.designation { color: #e8ad59; font-size: 12dp; letter-spacing: 2dp; margin-left: 8dp; }
.outcast .designation { color: #6dcbd8; }
.rule { height: 1dp; background-color: #364047; margin: 9dp 0 13dp 8dp; }
.series { color: #8496a3; font-size: 10dp; }
h2 { font-size: 28dp; margin: 3dp 0 5dp; }
.requirement { color: #bac5cd; font-size: 13dp; min-height: 36dp; margin-bottom: 10dp; }
label { display: block; color: #a6b4bd; font-size: 10dp; letter-spacing: 1dp; margin-bottom: 6dp; }
input { tab-index: auto; }
input[type=text] {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 34dp;
    padding: 7dp;
    background-color: #080e13;
    border: 1dp #52616b;
    color: #edf0f2;
    font-family: IBM Plex Mono;
    font-weight: normal;
    font-size: 12dp;
    cursor: text;
}
input[type=button] {
    display: inline-block;
    padding: 8dp 12dp;
    margin-right: 5dp;
    background-color: #202b33;
    border: 1dp #52616b;
    color: #e3e7e9;
    font-family: IBM Plex Sans;
    font-weight: 600;
    font-size: 13dp;
    cursor: pointer;
    text-align: center;
}
.tools { margin-top: 9dp; }
.readiness { margin: 15dp 0; min-height: 65dp; }
.state { font-size: 16dp; color: #e8ad59; margin-bottom: 4dp; }
.outcast .state { color: #6dcbd8; }
.detail { color: #a6b4bd; font-size: 12dp; max-height: 62dp; overflow: auto; word-break: break-all; }
.launch { border-top: 1dp #364047; padding-top: 13dp; }
.launch input { min-width: 80dp; }
.academy input.primary { color: #11171b; background-color: #e8ad59; border-color: #e8ad59; }
.outcast input.primary { color: #11171b; background-color: #6dcbd8; border-color: #6dcbd8; }
input:hover { border-color: #f4f6f7; }
input:focus { border-color: #ffffff; background-color: #30424e; color: #ffffff; }
.academy input.primary:focus, .outcast input.primary:focus { background-color: #ffffff; border-color: #ffffff; }
input:disabled { opacity: 0.45; cursor: arrow; }
.telemetry { margin-top: 16dp; padding: 11dp 15dp; border-left: 3dp #67757f; background-color: #121a21; }
#progress { margin-top: 5dp; color: #c6d5df; font-size: 12dp; word-break: break-all; max-height: 42dp; overflow: auto; }
#status { margin-top: 4dp; font-size: 13dp; word-break: break-all; }
.profile-line { margin-top: 12dp; }
#profile { font-size: 11dp; color: #a6b4bd; margin-top: 3dp; word-break: break-all; }
scrollbarvertical { width: 10dp; background-color: #111b23; }
scrollbarvertical sliderbar { background-color: #52616b; min-height: 20dp; }
scrollbarvertical slidertrack { background-color: #111b23; }
@media (max-width: 780dp) {
    #console { margin: 16dp; }
    .header { margin-bottom: 14dp; }
    h1 { font-size: 27dp; }
    .card { padding: 13dp; }
    .academy { margin-right: 10dp; }
    h2 { font-size: 25dp; }
    input[type=button] { padding: 8dp; }
}
@media (max-width: 600dp) {
    .campaigns { display: block; }
    .academy { margin-right: 0; margin-bottom: 14dp; }
}
