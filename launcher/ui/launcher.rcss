body, div, h1, h2 { display: block; }
body {
    margin: 0; width: 100%; height: 100%; overflow: auto;
    background-color: #04043a; color: white;
    font-family: IBM Plex Sans; font-weight: 600; font-size: 14dp;
}
#equaliser {
    position: absolute; left: 0; top: 0; width: 100%; height: 100%;
    display: flex; align-items: flex-end; overflow: hidden; pointer-events: none; z-index: 0;
}
.equaliser-band { flex: 1; height: 0; max-height: 75%; margin: 0 4dp; background-color: #101048; }
#console { position: relative; z-index: 1; margin: 20dp; }
h1 { margin: 0 0 8dp; font-size: 24dp; text-align: center; }
#last { text-align: center; margin-bottom: 18dp; color: #8cdaff; }
.campaigns { display: flex; }
.campaign { flex: 1; min-width: 0; padding: 18dp; border: 2dp #6365ec; background-color: #080830; }
.campaign + .campaign { margin-left: 18dp; }
h2 { margin: 0 0 12dp; font-size: 24dp; color: #8cdaff; }
.requirement { min-height: 32dp; margin-bottom: 12dp; }
label { display: block; margin-bottom: 6dp; color: #8cdaff; }
input { tab-index: auto; }
input[type=text] {
    display: block; box-sizing: border-box; width: 100%; height: 34dp;
    padding: 6dp; border: 1dp #6365ec; background-color: #02021c;
    color: white; font-family: IBM Plex Sans; font-size: 14dp; cursor: text;
}
input[type=button] {
    display: inline-block; padding: 8dp 6dp; margin-right: 6dp;
    border-width: 0; background-color: transparent;
    color: #ffae00; font-family: IBM Plex Sans; font-weight: 600;
    font-size: 16dp; cursor: pointer; text-align: center; text-transform: uppercase;
}
input[type=button]:hover, input[type=button]:focus { color: white; background-color: #17175a; }
input[type=text]:focus { border-color: white; }
input:disabled { color: #77778b; cursor: arrow; }
.tools { margin-top: 8dp; }
.readiness { margin: 14dp 0; min-height: 48dp; }
.save { color: #8cdaff; font-size: 12dp; margin-bottom: 8dp; word-break: break-all; }
.state { color: #8cdaff; margin-bottom: 6dp; }
.detail { max-height: 70dp; overflow: auto; word-break: break-all; }
.launch { border-top: 1dp #6365ec; padding-top: 8dp; }
.status-panel { margin: 12dp 0; padding: 12dp; border-top: 1dp #6365ec; }
#progress, #status, #profile { word-break: break-all; }
#progress { color: #8cdaff; max-height: 60dp; overflow: auto; }
#profile { font-size: 12dp; }
.footer { display: flex; align-items: center; margin-top: 10dp; }
#music { flex-shrink: 0; }
#music-credit { margin-left: 12dp; font-size: 12dp; color: #8cdaff; }
#music-error { font-size: 12dp; color: #ffae00; word-break: break-all; }
#band-stage { position: relative; width: 320dp; max-width: 100%; height: 68dp; margin: 4dp auto 0; pointer-events: none; }
#stage-floor { position: absolute; bottom: 0; width: 100%; height: 3dp; border-top: 1dp #414878; background-color: #11172e; }
#band-player { position: absolute; left: 50%; top: 0; width: 64dp; height: 64dp; margin-left: -32dp; }
scrollbarvertical { width: 10dp; }
scrollbarvertical slidertrack { background-color: #11152b; }
scrollbarvertical sliderbar { background-color: #7c84aa; min-height: 12dp; }
@media (max-width: 760dp) {
    #console { margin: 16dp; }
    .campaigns { display: block; }
    .campaign + .campaign { margin-left: 0; margin-top: 16dp; }
}
