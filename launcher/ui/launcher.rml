<rml>
<head>
    <title>OpenJedvibe</title>
    <link type="text/rcss" href="launcher.rcss" />
</head>
<body>
    <div id="equaliser"></div>
    <div id="console">
        <h1>OpenJedvibe</h1>
        <div id="last">Reading profile</div>
        <div class="campaigns">
            <div class="campaign">
                <h2>Jedi Outcast</h2>
                <div class="requirement">Requires Jedi Outcast and Jedi Academy files.</div>
                <label for="jo-path">Jedi Outcast folder</label>
                <input id="jo-path" type="text" value="" />
                <div class="tools">
                    <input id="jo-locate" type="button" value="Locate Files" />
                    <input id="jo-check" type="button" value="Check Files" />
                </div>
                <div class="readiness">
                    <div id="jo-state" class="state">Not checked</div>
                    <div id="jo-detail" class="detail">Select your installed game folder.</div>
                </div>
                <div id="jo-save" class="save"></div>
                <div class="launch">
                    <input id="jo-play" type="button" value="Continue" />
                    <input id="jo-new" type="button" value="New Game" />
                    <input id="jo-menu" type="button" value="Main Menu" />
                </div>
            </div>
            <div class="campaign">
                <h2>Jedi Academy</h2>
                <div class="requirement">Requires Jedi Academy files.</div>
                <label for="ja-path">Jedi Academy folder</label>
                <input id="ja-path" type="text" value="" />
                <div class="tools">
                    <input id="ja-locate" type="button" value="Locate Files" />
                    <input id="ja-check" type="button" value="Check Files" />
                </div>
                <div class="readiness">
                    <div id="ja-state" class="state">Not checked</div>
                    <div id="ja-detail" class="detail">Select your installed game folder.</div>
                </div>
                <div id="ja-save" class="save"></div>
                <div class="launch">
                    <input id="ja-play" type="button" value="Continue" />
                    <input id="ja-new" type="button" value="New Game" />
                    <input id="ja-menu" type="button" value="Main Menu" />
                </div>
            </div>
        </div>
        <div class="status-panel">
            <div id="progress"></div>
            <div id="status">Loading saved paths.</div>
        </div>
        <label>Settings and saves</label>
        <div id="profile">Reading profile location</div>
        <div class="footer">
            <input id="music" type="button" value="MUSIC: ON" />
            <div id="music-credit">Cantina Band — John Williams<br />MIDI: Nonstop2k · Chiptune: OpenJedvibe</div>
        </div>
        <div id="music-error"></div>
    </div>
</body>
</rml>
